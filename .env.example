# Dirección pública del sitio. La usan el mapa del sitio y las vistas previas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Estilo cartográfico de MapLibre. OpenFreeMap no requiere clave.
# Estilos públicos: liberty, bright, positron, dark, fiord.
# https://openfreemap.org/
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/fiord

# Lectura de lugares en el servidor. Si faltan las dos, la guía usa el catálogo local.
# No uses el prefijo NEXT_PUBLIC_: esas variables no deben llegar al navegador.
# La clave service_role no hace falta para la guía pública y no debe declararse aquí.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=
